# PROJECT SQUEEZE — Research Platform (Modul 1: Data Collector)
# Werte hier eintragen und als .env speichern (wird nicht committet).

# Finnhub: Fundamentaldaten + News — kostenloser Key unter https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage: technische Indikatoren — kostenloser Key unter https://www.alphavantage.co/support/#api-key
# Free-Tier: 25 Calls/Tag, 5 Calls/Minute — der Collector drosselt sich selbst daran.
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_DAILY_LIMIT=25

# Yahoo Finance und FINRA Short Interest benötigen keinen Key.

# Optional: Cron-Zeitplan für den täglichen Sammellauf (Standard: werktags 21:30 UTC)
# SQUEEZE_CRON_SCHEDULE=30 21 * * 1-5

# Optional: abweichender Pfad für die SQLite-Datenbank
# SQUEEZE_DB_PATH=./research/db/squeeze.db
